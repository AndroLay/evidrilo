# Machine-specific Apple build settings. Config.xcconfig is the checked-in
# empty baseline; put local overrides in one of these ignored files.
/apps/ios/Configuration/*.xcconfig
!/apps/ios/Configuration/Config.xcconfig
/apps/ios/Configuration/Local.xcconfig
/apps/ios/Configuration/*.xcconfig.local

