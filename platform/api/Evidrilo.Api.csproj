<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Evidrilo.Api</RootNamespace>
    <AssemblyName>Evidrilo.Api</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../shared/DatabaseConnectionStringParser.cs" Link="Configuration/DatabaseConnectionStringParser.cs" />
    <Compile Include="../shared/AccountExportDataWriter.cs" Link="Account/AccountExportDataWriter.cs" />
  </ItemGroup>
</Project>
