ASPNETCORE_ENVIRONMENT=Development
PORT=5080
CORS_ALLOWED_ORIGINS=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_DB_CONNECTION_STRING=<set-locally>
# Configure either the HMAC signing secret or the exact Authorization header
# value from the RevenueCat webhook integration. Keep both server-side only.
REVENUECAT_WEBHOOK_SECRET=<set-locally>
REVENUECAT_WEBHOOK_AUTHORIZATION=<set-locally>
REVENUECAT_ENTITLEMENT_ID=evidrilo_pro
# Real provider IDs, not the internal planning aliases monthly/yearly.
REVENUECAT_MONTHLY_PRODUCT_ID=<set-locally>
REVENUECAT_YEARLY_PRODUCT_ID=<set-locally>
# Optional AI provider. Remains disabled until activation, privacy, cost, and
# runtime gates have been approved. Never put the provider secret in the app.
AI_PROVIDER_ENABLED=false
AI_PROVIDER_ACTIVATION_APPROVED=false
AI_PROVIDER_BASE_URL=https://api.experientiallabs.ai/v1
# Prefer an absolute path to a regular owner-only file (mode 0600 on Unix).
# OPENAI_API_KEY remains available for existing direct-provider deployments.
AI_PROVIDER_API_KEY_FILE=<absolute-owner-only-secret-file>
AI_OPENAI_MODEL=gpt-6-luna
# Internal app-credit accounting rates from the accepted GPT-6 Luna policy.
AI_OPENAI_INPUT_USD_PER_MILLION_TOKENS=0.10
AI_OPENAI_CACHED_INPUT_USD_PER_MILLION_TOKENS=0.01
AI_OPENAI_CACHE_WRITE_INPUT_USD_PER_MILLION_TOKENS=0.125
AI_OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=0.50
AI_MAX_REQUEST_COST_USD=0.01
AI_MONTHLY_SPEND_LIMIT_USD=2
AI_MAX_OUTPUT_TOKENS=1024
AI_PROVIDER_TIMEOUT_SECONDS=60

# Omit while Experiential gpt-6-luna reports reasoning controls unsupported.
# AI_REASONING_EFFORT=max
