ASPNETCORE_ENVIRONMENT=Development
PORT=5080
CORS_ALLOWED_ORIGINS=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_DB_CONNECTION_STRING=<set-locally>
# Configure either the HMAC signing secret or the exact Authorization header
# value from the RevenueCat webhook integration. Keep both server-side only.
REVENUECAT_WEBHOOK_SECRET=<set-locally>
REVENUECAT_WEBHOOK_AUTHORIZATION=<set-locally>
REVENUECAT_ENTITLEMENT_ID=evidrilo_pro
# Real provider IDs, not the internal planning aliases monthly/yearly.
REVENUECAT_MONTHLY_PRODUCT_ID=<set-locally>
REVENUECAT_YEARLY_PRODUCT_ID=<set-locally>
# Optional AI provider. Remains disabled until activation, privacy, cost, and
# runtime gates have been approved. Never put the provider secret in the app.
AI_PROVIDER_ENABLED=false
AI_PROVIDER_ACTIVATION_APPROVED=false
OPENAI_API_KEY=<set-locally>
AI_OPENAI_MODEL=<owner-configured-pinned-model>
AI_OPENAI_INPUT_USD_PER_MILLION_TOKENS=<owner-reviewed-model-rate>
AI_OPENAI_CACHED_INPUT_USD_PER_MILLION_TOKENS=<owner-reviewed-model-rate>
AI_OPENAI_CACHE_WRITE_INPUT_USD_PER_MILLION_TOKENS=<owner-reviewed-model-rate>
AI_OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=<owner-reviewed-model-rate>
AI_MAX_REQUEST_COST_USD=<owner-configured-limit>
AI_MONTHLY_SPEND_LIMIT_USD=<owner-configured-limit>
AI_MAX_OUTPUT_TOKENS=512
AI_PROVIDER_TIMEOUT_SECONDS=5
