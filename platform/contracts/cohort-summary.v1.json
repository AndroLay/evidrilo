{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/cohort-summary.v1.json",
  "title": "Evidrilo aggregate cohort summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "cohortId", "learnerCount", "suppressed", "requestId"],
  "properties": {
    "schema": { "const": "evidrilo.cohort-summary" },
    "version": { "const": "1" },
    "cohortId": { "type": "string", "format": "uuid" },
    "learnerCount": { "type": "integer", "minimum": 0 },
    "suppressed": { "type": "boolean" },
    "completionRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "passRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" }
  }
}
