{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/case-summary.v1.json",
  "title": "Evidrilo published case summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "caseId", "caseVersionId", "title", "contentHash", "evaluatorVersion", "skillTags", "objective", "difficulty", "evidenceReferences", "facts", "rules", "variants", "requestId"],
  "properties": {
    "schema": { "const": "evidrilo.case-summary" },
    "version": { "const": "1" },
    "caseId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "caseVersionId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evaluatorVersion": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "skillTags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" }
    },
    "objective": { "type": "string", "minLength": 1, "maxLength": 200 },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "evidenceReferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
          "type": { "enum": ["aim", "context", "observation", "limitation", "boundary"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "anchorIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
          "outcome": { "enum": ["PASS", "ACTION_REQUIRED", "CANNOT_ASSESS", "INCOMPLETE"] },
          "anchorIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" }
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "removedFactIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
          "removedFactIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" }
          }
        }
      }
    },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" }
  }
}
