{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/project-template-starter-drafts.v1.json",
  "title": "Evidrilo project template starter drafts v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "notice", "templates"],
  "properties": {
    "schema": { "const": "evidrilo.project-template-starter-drafts" },
    "version": { "const": "1" },
    "notice": { "const": "Candidate authoring material only; not reviewed or student-selectable. A normal example is a nominal scenario path, not a correct answer or favorable finding." },
    "templates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["templateId", "templateVersion", "family", "state", "content"],
        "properties": {
          "templateId": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$", "maxLength": 96 },
          "templateVersion": { "const": 1 },
          "family": {
            "enum": [
              "experimental_laboratory",
              "observational_survey",
              "literature_review",
              "qualitative_interview_field_study",
              "design_engineering"
            ]
          },
          "state": { "const": "draft" },
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title", "summary", "intendedOutput", "inputFields", "steps",
              "methodSpecificLimitations", "provenanceRequirements",
              "accessibilityExpectations", "examples"
            ],
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 160 },
              "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
              "intendedOutput": { "type": "string", "minLength": 1, "maxLength": 1200 },
              "inputFields": {
                "type": "array", "minItems": 1, "maxItems": 32,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["id", "kind", "label", "required"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$" },
                    "kind": {
                      "enum": ["assignment_brief", "research_question", "hypothesis", "source", "data", "analysis", "claim", "limitation", "next_action"]
                    },
                    "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                    "required": { "type": "boolean" }
                  }
                }
              },
              "steps": {
                "type": "array", "minItems": 1, "maxItems": 48,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["id", "title", "inputFieldIds"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$" },
                    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                    "inputFieldIds": { "type": "array", "maxItems": 32, "items": { "type": "string" } }
                  }
                }
              },
              "methodSpecificLimitations": { "$ref": "#/$defs/textList" },
              "provenanceRequirements": { "$ref": "#/$defs/textList" },
              "accessibilityExpectations": { "$ref": "#/$defs/textList" },
              "examples": {
                "type": "array", "minItems": 1, "maxItems": 24,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["id", "summary", "reviewed", "kind"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$" },
                    "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
                    "reviewed": { "const": false },
                    "kind": { "enum": ["normal", "edge_or_conflicting"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "textList": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": { "type": "string", "minLength": 1, "maxLength": 1200 }
    }
  }
}
