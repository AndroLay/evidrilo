{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/ai-conversation-turn.v2.json",
  "title": "Evidrilo AI conversation turn response v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "groundedAnchorIds", "autoApplied", "turnsUsed", "turnsRemaining", "requestId", "creditCost"],
  "properties": {
    "schema": { "const": "evidrilo.ai-conversation-turn" },
    "version": { "const": "2" },
    "status": { "enum": ["success", "fallback"] },
    "kind": { "enum": ["explanation", "reflection_question", "language_alternative", "draft_proposal", null] },
    "text": { "type": ["string", "null"], "maxLength": 2000 },
    "reasonCode": { "type": ["string", "null"], "maxLength": 64 },
    "groundedAnchorIds": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "proposal": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "beforeValue", "suggestedValue", "anchorIds"],
          "properties": {
            "field": { "enum": ["claim_text", "claim_scope", "learner_limitation", "next_action"] },
            "beforeValue": { "type": ["string", "null"], "maxLength": 2000 },
            "suggestedValue": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "anchorIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        }
      ]
    },
    "autoApplied": { "const": false },
    "turnsUsed": { "type": "integer", "minimum": 0, "maximum": 5 },
    "turnsRemaining": { "type": "integer", "minimum": 0, "maximum": 5 },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" },
    "creditCost": { "type": "integer", "minimum": 0, "maximum": 200 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "success" } }, "required": ["status"] },
      "then": {
        "required": ["kind", "text"],
        "properties": { "creditCost": { "minimum": 1 }, "kind": { "type": "string" }, "text": { "type": "string", "minLength": 1 } }
      },
      "else": {
        "required": ["reasonCode"],
        "properties": { "reasonCode": { "type": "string", "minLength": 1 } }
      }
    }
  ]
}
