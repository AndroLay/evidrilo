{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/project-ai-stage-assist-settlement.v1.json",
  "title": "Evidrilo stage-assist settlement response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "outcome", "requestId", "creditCost"],
  "properties": {
    "schema": { "const": "evidrilo.project-ai-stage-assist-settlement" },
    "version": { "const": "1" },
    "outcome": { "enum": ["APPLIED", "EDITED", "DISMISSED", "STALE"] },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" },
    "creditCost": { "type": "integer", "minimum": 1, "maximum": 200 }
  }
}
