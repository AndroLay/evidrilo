{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/project-ai-general-chat-result.v2.json",
  "title": "Evidrilo isolated Project AI General chat result v2",
  "description": "Structured answer, standalone suggested follow-up prompts, and token-priced credit cost. The message, answer, and prompts are not part of activity history.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "mode", "status", "answer", "recommendedNextPrompts", "requestId", "creditCost"],
  "properties": {
    "schema": { "const": "evidrilo.project-ai-general-chat" },
    "version": { "const": "2" },
    "mode": { "const": "GENERAL" },
    "status": { "const": "success" },
    "answer": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "recommendedNextPrompts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "creditCost": { "type": "integer", "minimum": 1, "maximum": 200 }
  }
}
