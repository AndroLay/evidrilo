{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/student-project-revisions.v1.json",
  "title": "Evidrilo student project revision response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "projectId", "revisions", "nextBeforeVersion", "requestId"],
  "properties": {
    "schema": { "const": "evidrilo.student-project-revisions" },
    "version": { "const": "1" },
    "projectId": { "type": "string", "format": "uuid" },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revisionId", "version", "document", "createdAt"],
        "properties": {
          "revisionId": { "type": "string", "format": "uuid" },
          "version": { "type": "integer", "minimum": 1 },
          "document": { "$ref": "student-project.v1.json#/$defs/projectDocument" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "nextBeforeVersion": { "type": ["integer", "null"], "minimum": 1 },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" }
  }
}
