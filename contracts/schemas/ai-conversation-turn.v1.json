{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/ai-conversation-turn.v1.json",
  "title": "Evidrilo AI conversation turn response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "groundedAnchorIds", "autoApplied", "turnsUsed", "turnsRemaining", "requestId"],
  "properties": {
    "schema": { "const": "evidrilo.ai-conversation-turn" },
    "version": { "const": "1" },
    "status": { "enum": ["success", "fallback"] },
    "kind": { "enum": ["explanation", "reflection_question", "language_alternative", "draft_proposal"] },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "reasonCode": { "type": "string", "minLength": 1, "maxLength": 64 },
    "groundedAnchorIds": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "beforeValue", "suggestedValue", "anchorIds"],
      "properties": {
        "field": { "enum": ["claim_text", "claim_scope", "learner_limitation", "next_action"] },
        "beforeValue": { "type": ["string", "null"], "maxLength": 2000 },
        "suggestedValue": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "anchorIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
      }
    },
    "autoApplied": { "const": false },
    "turnsUsed": { "type": "integer", "minimum": 0, "maximum": 5 },
    "turnsRemaining": { "type": "integer", "minimum": 0, "maximum": 5 },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "success" } }, "required": ["status"] },
      "then": { "required": ["kind", "text"] },
      "else": { "required": ["reasonCode"] }
    }
  ]
}
