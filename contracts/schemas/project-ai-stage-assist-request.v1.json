{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/project-ai-stage-assist-request.v1.json",
  "title": "Evidrilo stage-bound Project AI request v1",
  "description": "A project request binds an authenticated account, installation, project revision, published template stage, and explicitly selected context. Server-owned cloud projects and account-bound local projects use distinct request branches. GENERAL remains unavailable until its separate policy is approved.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {},
    "version": {},
    "mode": {},
    "installationId": {},
    "locale": {},
    "projectId": {},
    "templateId": {},
    "templateVersion": {},
    "stageId": {},
    "operationId": {},
    "baseProjectRevision": {},
    "projectBindingGeneration": {},
    "selectedFieldIds": {},
    "selectedEvidenceIds": {},
    "selectedFields": {},
    "selectedEvidence": {}
  },
  "oneOf": [
    { "$ref": "#/$defs/projectRequest" },
    { "$ref": "#/$defs/localProjectRequest" },
    { "$ref": "#/$defs/generalRequest" }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "properties": {
        "schema": { "const": "evidrilo.project-ai-stage-assist" },
        "version": { "const": "1" },
        "mode": { "enum": ["PROJECT", "GENERAL"] },
        "installationId": { "type": "string", "format": "uuid" },
        "locale": { "type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$", "maxLength": 32 }
      },
      "required": ["schema", "version", "mode", "installationId", "locale"]
    },
    "projectRequest": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        { "$ref": "#/$defs/projectPayload" },
        {
          "not": {
            "anyOf": [
              { "required": ["projectBindingGeneration"] },
              { "required": ["selectedFields"] },
              { "required": ["selectedEvidence"] }
            ]
          }
        }
      ]
    },
    "localProjectRequest": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        { "$ref": "#/$defs/projectPayload" },
        { "type": "object", "required": ["projectBindingGeneration", "selectedFields", "selectedEvidence"] }
      ]
    },
    "projectPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "evidrilo.project-ai-stage-assist" },
        "version": { "const": "1" },
        "mode": { "const": "PROJECT" },
        "installationId": { "type": "string", "format": "uuid" },
        "locale": { "type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$", "maxLength": 32 },
        "projectId": { "type": "string", "format": "uuid" },
        "templateId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 96 },
        "templateVersion": { "type": "integer", "minimum": 1 },
        "stageId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 80 },
        "operationId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 80 },
        "baseProjectRevision": { "type": "integer", "minimum": 1 },
        "projectBindingGeneration": { "type": "integer", "minimum": 1 },
        "selectedFieldIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 80 }
        },
        "selectedEvidenceIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
        },
        "selectedFields": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 80 },
              "value": { "type": "string", "maxLength": 8000 }
            },
            "required": ["id", "value"]
          }
        },
        "selectedEvidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
              "kind": { "enum": ["SOURCE", "DATA", "OBSERVATION"] },
              "label": { "type": "string", "minLength": 1, "maxLength": 160 },
              "summary": { "type": ["string", "null"], "maxLength": 8000 },
              "origin": { "type": ["string", "null"], "maxLength": 500 }
            },
            "required": ["id", "kind", "label", "summary", "origin"]
          }
        }
      },
      "required": ["schema", "version", "mode", "installationId", "locale", "projectId", "templateId", "templateVersion", "stageId", "operationId", "baseProjectRevision", "selectedFieldIds", "selectedEvidenceIds"]
    },
    "generalRequest": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": { "const": "evidrilo.project-ai-stage-assist" },
            "version": { "const": "1" },
            "mode": { "const": "GENERAL" },
            "installationId": { "type": "string", "format": "uuid" },
            "locale": { "type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$", "maxLength": 32 },
            "selectedFieldIds": { "type": "array", "maxItems": 0 },
            "selectedEvidenceIds": { "type": "array", "maxItems": 0 },
            "selectedFields": { "type": "array", "maxItems": 0 },
            "selectedEvidence": { "type": "array", "maxItems": 0 }
          },
          "required": ["schema", "version", "mode", "installationId", "locale"]
        }
      ]
    }
  }
}
