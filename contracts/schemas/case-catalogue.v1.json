{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/case-catalogue.v1.json",
  "title": "Evidrilo published case catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "cases", "requestId"],
  "properties": {
    "schema": { "const": "evidrilo.case-catalogue" },
    "version": { "const": "1" },
    "cases": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "caseVersionId", "title", "contentHash", "evaluatorVersion", "skillTags", "objective", "difficulty"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
          "caseVersionId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "evaluatorVersion": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
          "skillTags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" }
          },
          "objective": { "type": "string", "minLength": 1, "maxLength": 200 },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" }
  }
}
