{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/entitlements.v1.json",
  "title": "Evidrilo account entitlements v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "entitlements", "requestId"],
  "properties": {
    "schema": { "const": "evidrilo.entitlements" },
    "version": { "const": "1" },
    "entitlements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entitlement", "status", "updatedAt"],
        "properties": {
          "entitlement": { "type": "string", "minLength": 1, "maxLength": 128 },
          "status": { "enum": ["active", "expired", "revoked"] },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" }
  }
}
