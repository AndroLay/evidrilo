{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/project-template-detail.v1.json",
  "title": "Evidrilo published project template detail response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "template", "requestId"],
  "properties": {
    "schema": { "const": "evidrilo.project-template-detail" },
    "version": { "const": "1" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "family", "title", "summary", "intendedOutput",
        "inputFields", "steps", "methodSpecificLimitations", "provenanceRequirements",
        "accessibilityExpectations", "examples", "publication", "publishedAt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$", "maxLength": 96 },
        "version": { "type": "integer", "minimum": 1 },
        "family": {
          "enum": [
            "experimental_laboratory",
            "observational_survey",
            "literature_review",
            "qualitative_interview_field_study",
            "design_engineering"
          ]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "intendedOutput": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "inputFields": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "label", "required"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$" },
              "kind": { "enum": ["assignment_brief", "research_question", "hypothesis", "source", "data", "analysis", "claim", "limitation", "next_action"] },
              "label": { "type": "string", "minLength": 1, "maxLength": 200 },
              "required": { "type": "boolean" }
            }
          }
        },
        "steps": {
          "type": "array", "minItems": 1, "maxItems": 48,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "title", "inputFieldIds"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$" },
              "title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "inputFieldIds": { "type": "array", "maxItems": 32, "items": { "type": "string" } }
            }
          }
        },
        "methodSpecificLimitations": { "$ref": "#/$defs/textList" },
        "provenanceRequirements": { "$ref": "#/$defs/textList" },
        "accessibilityExpectations": { "$ref": "#/$defs/textList" },
        "examples": {
          "type": "array", "maxItems": 24,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "summary", "reviewed", "kind"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$" },
              "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
              "reviewed": { "const": true },
              "kind": { "enum": ["unspecified", "normal", "edge_or_conflicting"] }
            }
          }
        },
        "publication": { "const": "published" },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" }
  },
  "$defs": {
    "textList": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": { "type": "string", "minLength": 1, "maxLength": 1200 }
    }
  }
}
