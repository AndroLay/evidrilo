{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/project-ai-stage-assist.v1.json",
  "title": "Evidrilo stage-bound Project AI preview response v1",
  "description": "A non-mutating, typed proposal bound to the authenticated account's registered local project revision and context generation. References are limited to the student's explicitly selected project evidence. The client must review and apply through its project workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "mode", "projectId", "baseProjectRevision", "projectBindingGeneration", "consentGeneration", "stageId", "operationId", "assist", "evaluationPreview", "requestId", "creditCost"],
  "properties": {
    "schema": { "const": "evidrilo.project-ai-stage-assist" },
    "version": { "const": "1" },
    "status": { "const": "preview" },
    "mode": { "const": "PROJECT" },
    "projectId": { "type": "string", "format": "uuid" },
    "baseProjectRevision": { "type": "integer", "minimum": 1 },
    "projectBindingGeneration": { "type": ["integer", "null"], "minimum": 1 },
    "consentGeneration": { "type": "integer", "minimum": 1 },
    "stageId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 80 },
    "operationId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 80 },
    "assist": { "$ref": "#/$defs/assist" },
    "evaluationPreview": { "$ref": "#/$defs/evaluationPreview" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" },
    "creditCost": { "type": "integer", "minimum": 1, "maximum": 200 }
  },
  "$defs": {
    "assist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "templateVersion", "promptVersion", "items", "reportedConflicts", "reportedOutOfScopeItems"],
      "properties": {
        "templateId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 96 },
        "templateVersion": { "type": "integer", "minimum": 1 },
        "promptVersion": { "const": "project-ai-stage-assist.v1" },
        "items": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "$ref": "#/$defs/assistItem" } },
        "reportedConflicts": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 800 } },
        "reportedOutOfScopeItems": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 800 } }
      }
    },
    "assistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "referenceIds", "assumptions", "uncertainties", "knownLimits"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 80 },
        "kind": { "enum": ["EXPLANATION", "QUESTION", "PROPOSAL"] },
        "text": { "type": ["string", "null"], "maxLength": 2000 },
        "targetFieldId": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 80 },
        "beforeValue": { "type": ["string", "null"], "maxLength": 8000 },
        "afterValue": { "type": ["string", "null"], "maxLength": 8000 },
        "referenceIds": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" } },
        "assumptions": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 800 } },
        "uncertainties": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 800 } },
        "knownLimits": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 800 } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "EXPLANATION" } } },
          "then": {
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "targetFieldId": { "type": "null" },
              "beforeValue": { "type": "null" },
              "afterValue": { "type": "null" },
              "referenceIds": { "maxItems": 0 },
              "assumptions": { "maxItems": 0 },
              "uncertainties": { "maxItems": 0 },
              "knownLimits": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "QUESTION" } } },
          "then": {
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "targetFieldId": { "type": "null" },
              "beforeValue": { "type": "null" },
              "afterValue": { "type": "null" },
              "referenceIds": { "maxItems": 0 },
              "assumptions": { "maxItems": 0 },
              "uncertainties": { "maxItems": 0 },
              "knownLimits": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "PROPOSAL" } } },
          "then": {
            "required": ["targetFieldId", "beforeValue", "afterValue"],
            "properties": {
              "text": { "type": "null" },
              "targetFieldId": { "type": "string", "minLength": 1 },
              "beforeValue": { "type": "string" },
              "afterValue": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "kind": { "enum": ["SOURCE", "DATA", "OBSERVATION"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "evaluationPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentStatus", "supportingItems", "proposalsWithoutReferences", "reportedConflicts", "reportedAssumptions", "reportedUncertainties", "reportedKnownLimits", "templateLimits", "reportedOutOfScopeItems", "checksUnavailable"],
      "properties": {
        "assessmentStatus": { "const": "NOT_ASSESSED" },
        "supportingItems": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/evidenceReference" } },
        "proposalsWithoutReferences": { "type": "array", "maxItems": 24, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 80 } },
        "reportedConflicts": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 800 } },
        "reportedAssumptions": { "type": "array", "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 800 } },
        "reportedUncertainties": { "type": "array", "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 800 } },
        "reportedKnownLimits": { "type": "array", "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 800 } },
        "templateLimits": { "type": "array", "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 1200 } },
        "reportedOutOfScopeItems": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 800 } },
        "checksUnavailable": {
          "const": ["ACADEMIC_TRUTH", "SEMANTIC_REFERENCE_SUPPORT", "SOURCE_QUALITY", "POST_APPLY_STRUCTURE"]
        }
      }
    }
  }
}
