{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/project-ai-scaffold.v1.json",
  "title": "Evidrilo project AI scaffold preview response v1",
  "description": "A successful preview reports the credits charged from validated token usage. The server reserves the maximum possible request cost before provider dispatch and settles the actual cost after generation, regardless of whether the student later applies or dismisses the preview. The local project ID and revision are echoed for stale-context rejection; local project content is not persisted by this endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "scaffold", "operation", "projectId", "baseProjectRevision", "reasonCode", "requestId", "creditCost"],
  "properties": {
    "schema": { "const": "evidrilo.project-ai-scaffold" },
    "version": { "const": "1" },
    "status": { "const": "preview" },
    "scaffold": { "$ref": "#/$defs/scaffold" },
    "operation": { "enum": ["create_project", "assist_project"] },
    "projectId": {
      "oneOf": [
        { "type": "string", "format": "uuid" },
        { "type": "null" }
      ]
    },
    "baseProjectRevision": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "null" }
      ]
    },
    "reasonCode": { "type": "null" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" },
    "creditCost": { "type": "integer", "minimum": 1, "maximum": 200 }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "create_project" } }, "required": ["operation"] },
      "then": {
        "properties": {
          "projectId": { "type": "null" },
          "baseProjectRevision": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "operation": { "const": "assist_project" } }, "required": ["operation"] },
      "then": {
        "properties": {
          "projectId": { "type": "string", "format": "uuid" },
          "baseProjectRevision": { "type": "integer", "minimum": 1 }
        }
      }
    }
  ],
  "$defs": {
    "scaffold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "templateVersion", "promptVersion", "guidanceText", "fieldSuggestions", "clarificationQuestions", "recommendedNextPrompts"],
      "properties": {
        "templateId": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$", "maxLength": 96 },
        "templateVersion": { "type": "integer", "minimum": 1 },
        "promptVersion": { "const": "project-scaffold.v1" },
        "guidanceText": { "type": "string", "minLength": 1, "maxLength": 2500 },
        "fieldSuggestions": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/fieldSuggestion" }
        },
        "clarificationQuestions": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "recommendedNextPrompts": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "fieldSuggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldId", "suggestedValue"],
      "properties": {
        "fieldId": { "type": "string", "minLength": 1, "maxLength": 96 },
        "suggestedValue": { "type": "string", "minLength": 1, "maxLength": 8000 }
      }
    }
  }
}
