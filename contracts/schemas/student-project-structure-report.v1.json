{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/student-project-structure-report.v1.json",
  "title": "Evidrilo student project structure report response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "projectId", "projectVersion", "assessmentStatus", "academicMeritAssessed", "sections", "criterionEvidenceLinkCount", "claimEvidenceLinkCount", "notice", "requestId"],
  "properties": {
    "schema": { "const": "evidrilo.student-project-structure-report" },
    "version": { "const": "1" },
    "projectId": { "type": "string", "format": "uuid" },
    "projectVersion": { "type": "integer", "minimum": 1 },
    "assessmentStatus": { "const": "not_assessed" },
    "academicMeritAssessed": { "const": false },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "state", "itemCount"],
        "properties": {
          "section": { "type": "string" },
          "state": { "enum": ["provided", "not_provided"] },
          "itemCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "criterionEvidenceLinkCount": { "type": "integer", "minimum": 0 },
    "claimEvidenceLinkCount": { "type": "integer", "minimum": 0 },
    "notice": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" }
  }
}
