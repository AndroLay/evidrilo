{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/ai-credits.v1.json",
  "title": "Evidrilo AI credits v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "consentRecorded", "available", "grants", "requestId"],
  "properties": {
    "schema": { "const": "evidrilo.ai-credits" },
    "version": { "const": "1" },
    "consentRecorded": { "type": "boolean" },
    "available": { "type": "integer", "minimum": 0, "maximum": 110 },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["grantKind", "grantKey", "granted", "reserved", "consumed", "available", "expiresAt"],
        "properties": {
          "grantKind": { "enum": ["free_once", "subscription_month"] },
          "grantKey": { "type": "string", "minLength": 1, "maxLength": 64 },
          "granted": { "type": "integer", "minimum": 1, "maximum": 100 },
          "reserved": { "type": "integer", "minimum": 0, "maximum": 100 },
          "consumed": { "type": "integer", "minimum": 0, "maximum": 100 },
          "available": { "type": "integer", "minimum": 0, "maximum": 100 },
          "expiresAt": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" }
  }
}
