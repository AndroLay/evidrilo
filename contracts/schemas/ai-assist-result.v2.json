{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/ai-assist-result.v2.json",
  "title": "Evidrilo AI assist result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "text", "reasonCode", "promptVersion", "groundedAnchorIds", "requestId", "creditCost"],
  "properties": {
    "schema": { "const": "evidrilo.ai-assist-result" },
    "version": { "const": "2" },
    "status": { "enum": ["success", "fallback"] },
    "text": { "type": ["string", "null"], "maxLength": 2000 },
    "reasonCode": { "type": ["string", "null"], "pattern": "^[A-Z0-9_]{3,64}$" },
    "promptVersion": { "type": "string", "pattern": "^[a-z0-9._-]{1,64}$" },
    "groundedAnchorIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
      "maxItems": 32,
      "uniqueItems": true
    },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" },
    "creditCost": { "type": "integer", "minimum": 0, "maximum": 200 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "success" } }, "required": ["status"] },
      "then": { "properties": { "creditCost": { "minimum": 1 } } }
    }
  ]
}
