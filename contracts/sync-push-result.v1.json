{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/sync-push-result.v1.json",
  "title": "Evidrilo sync push result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "results", "nextCursor", "requestId"],
  "properties": {
    "schema": { "const": "evidrilo.sync-push-result" },
    "version": { "const": "1" },
    "results": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commandId", "outcome"],
        "properties": {
          "commandId": { "type": "string", "format": "uuid" },
          "outcome": { "type": "string", "enum": ["accepted", "duplicate", "conflict", "rejected"] },
          "serverSequence": { "type": "integer", "minimum": 1 },
          "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
        }
      }
    },
    "nextCursor": { "type": "integer", "minimum": 0 },
    "requestId": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" }
  }
}
