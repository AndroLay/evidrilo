{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidrilo.dev/contracts/case-lifecycle-audit.v1.json",
  "title": "Evidrilo case lifecycle audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "caseVersionId", "events", "truncated", "requestId"],
  "properties": {
    "schema": { "const": "evidrilo.case-lifecycle-audit" },
    "version": { "const": "1" },
    "caseVersionId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "events": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["auditEventId", "actorAccountId", "eventType", "fromState", "toState", "reason", "createdAt"],
        "properties": {
          "auditEventId": { "type": "string", "format": "uuid" },
          "actorAccountId": { "type": ["string", "null"], "format": "uuid" },
          "eventType": { "enum": ["created", "transitioned"] },
          "fromState": { "type": ["string", "null"], "enum": ["draft", "review", "approved", "published", "retired", null] },
          "toState": { "enum": ["draft", "review", "approved", "published", "retired"] },
          "reason": { "type": ["string", "null"], "maxLength": 2000 },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "truncated": { "type": "boolean" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" }
  }
}
